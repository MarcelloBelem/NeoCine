generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum MediaType {
  movie
  tv
}


model User {
  id String @id @default(cuid())
  name String 
  email String @unique
  birthdate DateTime
  password String
  bio String? 
  media UserMedia[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id  Int @id @default(autoincrement())
  tmdbId Int @unique
  type MediaType
  title String
  genres Json
  vote_average Float
  poster_path String
  duration Int?
  users UserMedia[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserMedia{
  id Int @id @default(autoincrement())
  userId String
  mediaId Int
  isWatched Boolean @default(false)
  inWatchlist   Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])
  @@unique([userId, mediaId])
}